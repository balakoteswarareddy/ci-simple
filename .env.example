# =====================================================================
# CI Agent — environment template. Copy to .env and fill in values.
# NEVER commit a real .env with secrets.
# Full reference: LOCAL_SERVICES.md
# =====================================================================

# --- Core ---
CI_AGENT_ENV=dev                 # dev | prod
CI_AGENT_DATA_DIR=./data
CI_AGENT_API_KEY=                # if set, required as X-API-Key header (except /healthz)
CI_AGENT_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Database (default: local SQLite file; compose uses Postgres) ---
# SQLite:  sqlite:///./data/ci-agent.db
# Postgres: postgresql+psycopg2://ciagent:ciagent-dev-pw@localhost:5432/ciagent
DATABASE_URL=sqlite:///./data/ci-agent.db
POSTGRES_USER=ciagent
POSTGRES_PASSWORD=ciagent-dev-pw
POSTGRES_DB=ciagent

# --- Redis cache (optional; falls back to in-memory) ---
REDIS_URL=                      # e.g. redis://localhost:6379/0

# --- Policy engine (OPA) ---
# If OPA_URL is empty, the built-in local evaluator is used (dev/test only).
# If OPA_URL is set and unreachable, runs FAIL CLOSED (explicit error).
OPA_URL=                        # e.g. http://localhost:8181
OPA_TIMEOUT_SECONDS=10
OPA_BUNDLE_DIR=./deploy/opa/store

# --- LLM (Azure AI Foundry / OpenAI-compatible) ---
# If not configured, the deterministic offline planner is used and every
# decision records planner="deterministic-fallback" in its evidence.
LLM_PROVIDER=                   # azure-foundry | openai | none
FOUNDRY_ENDPOINT=               # e.g. https://my-foundry.openai.azure.com/
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=gpt-4o-mini
FOUNDRY_API_VERSION=2024-10-21
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.1

# --- GitHub integration ---
GITHUB_TOKEN=                   # server-side token for clone/PR/branches/checks
GITHUB_API_URL=https://api.github.com
ALLOWED_GIT_HOSTS=github.com   # comma-separated; local paths need ALLOW_LOCAL_REPOS=true
ALLOW_LOCAL_REPOS=false         # true ONLY for dev/tests with fixture repos

# --- Knowledge ingestion ---
KNOWLEDGE_CACHE_TTL_HOURS=24
KNOWLEDGE_FETCH_TIMEOUT_SECONDS=20
KNOWLEDGE_ALLOW_HOSTS=docs.python.org,nodejs.org,go.dev,doc.rust-lang.org,github.com,raw.githubusercontent.com,docs.github.com,marketplace.visualstudio.com,osv.dev,api.osv.dev

# --- Execution sandbox ---
SANDBOX_MODE=local             # local | docker
SANDBOX_DOCKER_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=600
SANDBOX_ALLOW_NETWORK=false

# --- Supply chain / attestations ---
COSIGN_KEY_REF=                # e.g. gcpkms://... ; empty = keyless (OIDC) when supported
CHAINLOOP_CONTROL_PLANE=       # empty = evidence stored locally only
CHAINLOOP_ROBOT_ACCOUNT=

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | text
METRICS_ENABLED=true
